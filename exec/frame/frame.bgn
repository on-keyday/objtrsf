
config.go.package = "frame"

enum FrameType:
    :u8
    stdin
    stdout
    stderr
    control
    synth


format FrameHeader:
    type :FrameType
    len :u32

# FrameHeader is fixed-size. Its byte length is exposed so a reader that only
# needs a frame's boundary takes it from the schema instead of restating it.
FrameHeaderSize ::= sizeof(FrameHeader)

format Frame:
    header :FrameHeader
    match header.type:
        FrameType.control => control :Control(input = input.subrange(header.len))
        .. => data :[header.len]u8

enum ControlType:
    :u8
    terminal_window_size
    signal
    end


format Control:
    type :ControlType
    match type:
        ControlType.terminal_window_size => terminal_window_size :TerminalWindowSize
        ControlType.signal => signal :Signal
        ControlType.end => end :End
        .. => error("Unexpected error")

format TerminalWindowSize:
    columns :u16
    rows :u16
    width :u16
    height :u16

format Signal:
    signal :i32

# End is the far side's last frame before it closes the stream: why the
# session is ending, so a client can say so instead of seeing the stream just
# close (e.g. a runner refusing to start the session). It is not output and is
# never written to a terminal. exit_code is the process's, or -1 when none ran.
format End:
    exit_code :i32
    reason_len :u16
    reason :[reason_len]u8
