
config.go.package = "wire"


format Varint:
    prefix :u2
    match prefix:
        0 => value :u6
        1 => value :u14
        2 => value :u30
        3 => value :u62

fn varintLen(value :u64) -> u8:
    return match value:
        u64(0)..=0x3f => 1
        u64(0x40)..=0x3fff => 2
        u64(0x4000)..=0x3fffffff => 4
        0x40000000..=0x3fffffffffffffff => 8
        .. => 0

fn varintPrefix(value :u64) -> u8:
    len ::= varintLen(value)
    return match len:
        1 => 0
        2 => 1
        4 => 2
        8 => 3
        .. => 0xff


format StreamPacket:
    config.go.union = "noheap"
    has_id :u1
    has_offset :u1
    is_eof :u1
    is_probe :u1
    reserved :u4
    if has_id == 1:
        id :Varint
    if has_offset == 1:
        offset :Varint
    data :[..]u8

format ACKRange:
    offset :Varint 
    delta :Varint


# ack_delay is how long the RECEIVER held largest_ack before sending this ACK,
# in microseconds. RFC 9002 5.3: the sender subtracts it from the RTT sample, so
# a receiver that batches ACKs does not inflate the peer's smoothed_rtt with its
# own scheduling. Without it, srtt is the path PLUS whatever the far side's run
# loop was busy with, and every timer derived from srtt inherits that.
#
# min_rtt is deliberately NOT adjusted by it (RFC 9002 5.2), so min_rtt stays a
# lower bound on the path itself and srtt - min_rtt stays readable as queueing.
#
# It is a LOWER BOUND: the clock starts when the receiver's run loop processes
# the packet, so time the packet spent in the receive queue before that is not
# counted, nor is the hop from building the ACK to the socket.
format StreamACKPacket:
    largest_ack :Varint
    ack_delay :Varint
    first_delta :Varint
    len :Varint 
    ranges :[len.value]ACKRange

format UpdateWindow:
    id :Varint
    window_max :Varint

format CancelStreamPacket:
    id :Varint

# Optional transport-keepalive / teardown bodies. ping/pong/close carry an
# OPTIONAL rest-of-packet body after the kind byte: a 0-length body is valid
# (bare keepalive / teardown). A ping initiator MAY send PingBody{nanos}; the
# responder echoes the received body verbatim in its pong so the initiator can
# compute RTT (time.Since). close MAY carry a CloseBody for diagnostics.
enum CloseStatus:
    :u8
    ok
    failed

format PingBody:
    nanos :u64

format CloseBody:
    status :CloseStatus
    message_len :u16
    message :[message_len]u8

# Transport-only payload kinds (the shared trsf core's whole vocabulary). They
# occupy the reserved transport range 0x00-0x3F; application kinds live in a
# Start of the application-defined kind range. Transport-owned kinds live in
# 0x00..0x3F; consumers define their own kinds at >= USER_DEFINED_START and the
# core passes any such non-transport kind out via AutoReceive's receive seam.
USER_DEFINED_START ::= 0x40

# repo-local enum at >= 0x40 (harness: appwire.AppKind) so the shared core never
# needs to know them — AutoReceive handles these and routes everything else out.
enum ApplicationPayloadKind:
    :u8
    ping
    pong
    close
    stream_data
    stream_cancel
    stream_ack
    stream_window_update
    datagram


# DatagramPacket carries one unreliable application payload: delivered at most
# once, never retransmitted, but acknowledged like stream data so the sender can
# tell a drop from an arrival.
#
# It is transport-owned rather than a consumer kind at >= USER_DEFINED_START,
# and that placement is the whole point. AutoReceive hands consumer kinds
# straight to the application seam without their packet number ever reaching
# PacketNumTracker, so a payload carried there can never be ACKed and its loss
# can never be observed.
#
# There is no length field. objproto does not split an application message, so
# one datagram is exactly one packet and rest-of-packet is exact.
#
# Congestion mode is deliberately NOT on the wire. Whether the sender counted
# this packet against its own window is the sender's property; the receiver
# acknowledges both modes identically, so a bit here would offer the receiver a
# choice it does not have.
format DatagramPacket:
    data :[..]u8

format PacketHeader:
    kind :ApplicationPayloadKind

# isStreamRelated answers "does the run loop handle this kind", which is what
# its one caller (AutoReceive) asks of it. The name describes the membership it
# had when every such kind was a stream kind; a datagram qualifies because
# StreamAppPacket decodes it and handlePacket dispatches it, not because it is
# stream-related.
#
# This membership must equal StreamAppPacket's arms below. is_defined cannot
# derive that -- it answers enum membership and this is a SUBSET -- so the two
# lists are kept in step by hand. The expensive direction is a kind added to the
# union but not here: it reaches onEvent and vanishes with no error anywhere,
# which is what the transport-range guard in AutoReceive exists to catch.
fn isStreamRelated(kind :ApplicationPayloadKind) -> bool:
    return match kind:
        ApplicationPayloadKind.stream_data,ApplicationPayloadKind.stream_cancel,
        ApplicationPayloadKind.stream_ack, ApplicationPayloadKind.stream_window_update,
        ApplicationPayloadKind.datagram => true
        .. => false

format StreamAppPacket:
    config.go.union = "noheap"
    header :PacketHeader
    match header.kind:
        ApplicationPayloadKind.stream_data => stream_data :StreamPacket
        ApplicationPayloadKind.stream_cancel => stream_cancel :CancelStreamPacket
        ApplicationPayloadKind.stream_ack => stream_ack :StreamACKPacket
        ApplicationPayloadKind.stream_window_update => window_update :UpdateWindow
        ApplicationPayloadKind.datagram => datagram :DatagramPacket
        .. => error("Unexpected packet")
